{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "madinlabagency.com" }],
      "destination": "https://www.madinlabagency.com/:path*",
      "permanent": true
    }
  ]
}
